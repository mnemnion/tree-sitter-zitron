{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/grammar.schema.json",
  "name": "zitron",
  "rules": {
    "source_file": {
      "type": "REPEAT",
      "content": {
        "type": "SYMBOL",
        "name": "_declaration"
      }
    },
    "_declaration": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "grammar_rule"
        },
        {
          "type": "SYMBOL",
          "name": "ditto_rule"
        },
        {
          "type": "SYMBOL",
          "name": "directive"
        },
        {
          "type": "SYMBOL",
          "name": "bad_directive"
        }
      ]
    },
    "grammar_rule": {
      "type": "SEQ",
      "members": [
        {
          "type": "FIELD",
          "name": "rule_def",
          "content": {
            "type": "SYMBOL",
            "name": "lhs"
          }
        },
        {
          "type": "STRING",
          "value": "::="
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "rhs"
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "STRING",
          "value": "."
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "_action"
            },
            {
              "type": "BLANK"
            }
          ]
        }
      ]
    },
    "ditto_rule": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "``"
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "STRING",
              "value": "::="
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "rhs"
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "STRING",
          "value": "."
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "_action"
            },
            {
              "type": "BLANK"
            }
          ]
        }
      ]
    },
    "directive": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "_ordinary_directive"
        },
        {
          "type": "SYMBOL",
          "name": "_impl_directive"
        },
        {
          "type": "SYMBOL",
          "name": "_macro_directive"
        },
        {
          "type": "SYMBOL",
          "name": "_arg_directive"
        },
        {
          "type": "SYMBOL",
          "name": "_token_directive"
        },
        {
          "type": "SYMBOL",
          "name": "_token_class_directive"
        }
      ]
    },
    "bad_directive": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "%"
        },
        {
          "type": "ALIAS",
          "content": {
            "type": "SYMBOL",
            "name": "identifier"
          },
          "named": true,
          "value": "bad_directive_name"
        },
        {
          "type": "SYMBOL",
          "name": "_directive_defn"
        }
      ]
    },
    "_production": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "_nonterminal_m_alias"
        },
        {
          "type": "SYMBOL",
          "name": "_terminal_m_alias"
        },
        {
          "type": "SYMBOL",
          "name": "_multiterminal_m_alias"
        }
      ]
    },
    "lhs": {
      "type": "SYMBOL",
      "name": "_nonterminal_m_alias"
    },
    "rhs": {
      "type": "REPEAT1",
      "content": {
        "type": "SYMBOL",
        "name": "_production"
      }
    },
    "_nonterminal_m_alias": {
      "type": "SEQ",
      "members": [
        {
          "type": "FIELD",
          "name": "rule_name",
          "content": {
            "type": "SYMBOL",
            "name": "nonterminal"
          }
        },
        {
          "type": "FIELD",
          "name": "alias",
          "content": {
            "type": "CHOICE",
            "members": [
              {
                "type": "SYMBOL",
                "name": "_alias_paren"
              },
              {
                "type": "BLANK"
              }
            ]
          }
        }
      ]
    },
    "_terminal_m_alias": {
      "type": "PREC_LEFT",
      "value": 2,
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "FIELD",
            "name": "rule_name",
            "content": {
              "type": "SYMBOL",
              "name": "terminal"
            }
          },
          {
            "type": "FIELD",
            "name": "alias",
            "content": {
              "type": "CHOICE",
              "members": [
                {
                  "type": "SYMBOL",
                  "name": "_alias_paren"
                },
                {
                  "type": "BLANK"
                }
              ]
            }
          }
        ]
      }
    },
    "_directive_defn": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "code_block"
        },
        {
          "type": "SYMBOL",
          "name": "string"
        },
        {
          "type": "SYMBOL",
          "name": "number"
        },
        {
          "type": "SYMBOL",
          "name": "identifier"
        }
      ]
    },
    "_multiterminal_m_alias": {
      "type": "SEQ",
      "members": [
        {
          "type": "FIELD",
          "name": "rule_name",
          "content": {
            "type": "SYMBOL",
            "name": "multiterminal"
          }
        },
        {
          "type": "FIELD",
          "name": "alias",
          "content": {
            "type": "CHOICE",
            "members": [
              {
                "type": "SYMBOL",
                "name": "_alias_paren"
              },
              {
                "type": "BLANK"
              }
            ]
          }
        }
      ]
    },
    "_alias_paren": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "("
        },
        {
          "type": "SYMBOL",
          "name": "rule_alias"
        },
        {
          "type": "STRING",
          "value": ")"
        }
      ]
    },
    "_action": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "code_block"
        },
        {
          "type": "FIELD",
          "name": "action_def",
          "content": {
            "type": "SYMBOL",
            "name": "named_action"
          }
        }
      ]
    },
    "code_block": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "{"
        },
        {
          "type": "SYMBOL",
          "name": "zig_code"
        },
        {
          "type": "STRING",
          "value": "}"
        }
      ]
    },
    "named_action": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "action_name"
        },
        {
          "type": "SYMBOL",
          "name": "_act_aliases"
        }
      ]
    },
    "_act_aliases": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "("
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SEQ",
              "members": [
                {
                  "type": "CHOICE",
                  "members": [
                    {
                      "type": "SYMBOL",
                      "name": "rule_alias"
                    },
                    {
                      "type": "BLANK"
                    }
                  ]
                },
                {
                  "type": "STRING",
                  "value": ";"
                },
                {
                  "type": "CHOICE",
                  "members": [
                    {
                      "type": "SYMBOL",
                      "name": "rule_alias"
                    },
                    {
                      "type": "BLANK"
                    }
                  ]
                },
                {
                  "type": "CHOICE",
                  "members": [
                    {
                      "type": "REPEAT",
                      "content": {
                        "type": "SEQ",
                        "members": [
                          {
                            "type": "STRING",
                            "value": ","
                          },
                          {
                            "type": "SYMBOL",
                            "name": "rule_alias"
                          }
                        ]
                      }
                    },
                    {
                      "type": "BLANK"
                    }
                  ]
                },
                {
                  "type": "CHOICE",
                  "members": [
                    {
                      "type": "STRING",
                      "value": ","
                    },
                    {
                      "type": "BLANK"
                    }
                  ]
                }
              ]
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "STRING",
          "value": ")"
        }
      ]
    },
    "_ordinary_directive": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "%"
        },
        {
          "type": "SYMBOL",
          "name": "directive_name"
        },
        {
          "type": "SYMBOL",
          "name": "_directive_defn"
        }
      ]
    },
    "_impl_directive": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "%"
        },
        {
          "type": "ALIAS",
          "content": {
            "type": "STRING",
            "value": "impl"
          },
          "named": true,
          "value": "impl_name"
        },
        {
          "type": "FIELD",
          "name": "action_impl",
          "content": {
            "type": "SYMBOL",
            "name": "named_action"
          }
        },
        {
          "type": "SYMBOL",
          "name": "code_block"
        }
      ]
    },
    "_arg_directive": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "%"
        },
        {
          "type": "SYMBOL",
          "name": "arg_directive_name"
        },
        {
          "type": "SYMBOL",
          "name": "identifier"
        },
        {
          "type": "SYMBOL",
          "name": "_directive_defn"
        }
      ]
    },
    "_token_directive": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "%"
        },
        {
          "type": "SYMBOL",
          "name": "token_directive_name"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "CHOICE",
            "members": [
              {
                "type": "SYMBOL",
                "name": "nonterminal"
              },
              {
                "type": "SYMBOL",
                "name": "terminal"
              }
            ]
          }
        },
        {
          "type": "STRING",
          "value": "."
        }
      ]
    },
    "_token_class_directive": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "%"
        },
        {
          "type": "ALIAS",
          "content": {
            "type": "STRING",
            "value": "token_class"
          },
          "named": true,
          "value": "impl_name"
        },
        {
          "type": "SYMBOL",
          "name": "nonterminal"
        },
        {
          "type": "SYMBOL",
          "name": "multiterminal"
        },
        {
          "type": "STRING",
          "value": "."
        }
      ]
    },
    "_macro_directive": {
      "type": "PREC_LEFT",
      "value": 0,
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "STRING",
            "value": "%"
          },
          {
            "type": "SYMBOL",
            "name": "macro_name"
          },
          {
            "type": "CHOICE",
            "members": [
              {
                "type": "SYMBOL",
                "name": "_macro_args"
              },
              {
                "type": "BLANK"
              }
            ]
          }
        ]
      }
    },
    "_macro_args": {
      "type": "REPEAT1",
      "content": {
        "type": "CHOICE",
        "members": [
          {
            "type": "SEQ",
            "members": [
              {
                "type": "STRING",
                "value": "("
              },
              {
                "type": "SYMBOL",
                "name": "_macro_element"
              },
              {
                "type": "STRING",
                "value": ")"
              }
            ]
          },
          {
            "type": "SYMBOL",
            "name": "_macro_element"
          }
        ]
      }
    },
    "_macro_element": {
      "type": "CHOICE",
      "members": [
        {
          "type": "ALIAS",
          "content": {
            "type": "SYMBOL",
            "name": "nonterminal"
          },
          "named": true,
          "value": "macro_nonterminal"
        },
        {
          "type": "ALIAS",
          "content": {
            "type": "SYMBOL",
            "name": "terminal"
          },
          "named": true,
          "value": "macro_terminal"
        },
        {
          "type": "STRING",
          "value": "&&"
        },
        {
          "type": "STRING",
          "value": "||"
        },
        {
          "type": "STRING",
          "value": "!"
        }
      ]
    },
    "nonterminal": {
      "type": "PATTERN",
      "value": "[a-z][a-zA-Z0-9_]*"
    },
    "terminal": {
      "type": "PATTERN",
      "value": "[A-Z][a-zA-Z0-9_]*"
    },
    "multiterminal": {
      "type": "PREC_LEFT",
      "value": 3,
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "SYMBOL",
            "name": "terminal"
          },
          {
            "type": "REPEAT",
            "content": {
              "type": "SEQ",
              "members": [
                {
                  "type": "CHOICE",
                  "members": [
                    {
                      "type": "STRING",
                      "value": "|"
                    },
                    {
                      "type": "STRING",
                      "value": "/"
                    }
                  ]
                },
                {
                  "type": "SYMBOL",
                  "name": "terminal"
                }
              ]
            }
          }
        ]
      }
    },
    "rule_alias": {
      "type": "PATTERN",
      "value": "[A-Za-z][A-Za-z0-9_]*"
    },
    "identifier": {
      "type": "PATTERN",
      "value": "[A-Za-z][A-Za-z0-9_]*"
    },
    "action_name": {
      "type": "PATTERN",
      "value": "@[a-z][a-zA-Z0-9_]*"
    },
    "word": {
      "type": "PATTERN",
      "value": "[a-z_]+"
    },
    "directive_name": {
      "type": "CHOICE",
      "members": [
        {
          "type": "STRING",
          "value": "name"
        },
        {
          "type": "STRING",
          "value": "include"
        },
        {
          "type": "STRING",
          "value": "code"
        },
        {
          "type": "STRING",
          "value": "token_enum"
        },
        {
          "type": "STRING",
          "value": "token_enum_integer"
        },
        {
          "type": "STRING",
          "value": "trace_writer"
        },
        {
          "type": "STRING",
          "value": "syntax_error"
        },
        {
          "type": "STRING",
          "value": "parse_accept"
        },
        {
          "type": "STRING",
          "value": "parse_error_type"
        },
        {
          "type": "STRING",
          "value": "parse_failure"
        },
        {
          "type": "STRING",
          "value": "stack_overflow"
        },
        {
          "type": "STRING",
          "value": "extra_argument"
        },
        {
          "type": "STRING",
          "value": "extra_context"
        },
        {
          "type": "STRING",
          "value": "token_type"
        },
        {
          "type": "STRING",
          "value": "default_type"
        },
        {
          "type": "STRING",
          "value": "stack_size"
        },
        {
          "type": "STRING",
          "value": "start_symbol"
        },
        {
          "type": "STRING",
          "value": "wildcard"
        },
        {
          "type": "STRING",
          "value": "token_destructor"
        },
        {
          "type": "STRING",
          "value": "default_destructor"
        }
      ]
    },
    "arg_directive_name": {
      "type": "CHOICE",
      "members": [
        {
          "type": "STRING",
          "value": "type"
        },
        {
          "type": "STRING",
          "value": "destructor"
        }
      ]
    },
    "token_directive_name": {
      "type": "CHOICE",
      "members": [
        {
          "type": "STRING",
          "value": "left"
        },
        {
          "type": "STRING",
          "value": "right"
        },
        {
          "type": "STRING",
          "value": "nonassoc"
        },
        {
          "type": "STRING",
          "value": "token"
        },
        {
          "type": "STRING",
          "value": "fallback"
        }
      ]
    },
    "macro_name": {
      "type": "CHOICE",
      "members": [
        {
          "type": "STRING",
          "value": "if"
        },
        {
          "type": "STRING",
          "value": "ifdef"
        },
        {
          "type": "STRING",
          "value": "ifndef"
        },
        {
          "type": "STRING",
          "value": "else"
        },
        {
          "type": "STRING",
          "value": "endif"
        }
      ]
    },
    "string": {
      "type": "PATTERN",
      "value": "\"[^\\\"]*\""
    },
    "number": {
      "type": "PATTERN",
      "value": "\\d+"
    },
    "comment": {
      "type": "TOKEN",
      "content": {
        "type": "CHOICE",
        "members": [
          {
            "type": "SEQ",
            "members": [
              {
                "type": "STRING",
                "value": "//"
              },
              {
                "type": "PATTERN",
                "value": "(\\\\+(.|\\r?\\n)|[^\\\\\\n])*"
              }
            ]
          },
          {
            "type": "SEQ",
            "members": [
              {
                "type": "STRING",
                "value": "/*"
              },
              {
                "type": "PATTERN",
                "value": "[^*]*\\*+([^/*][^*]*\\*+)*"
              },
              {
                "type": "STRING",
                "value": "/"
              }
            ]
          }
        ]
      }
    }
  },
  "extras": [
    {
      "type": "PATTERN",
      "value": "\\s|\\\\\\r?\\n"
    },
    {
      "type": "SYMBOL",
      "name": "comment"
    }
  ],
  "conflicts": [],
  "precedences": [],
  "externals": [
