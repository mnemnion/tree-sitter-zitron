{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/grammar.schema.json",
  "name": "zitron",
  "rules": {
    "source_file": {
      "type": "REPEAT",
      "content": {
        "type": "SYMBOL",
        "name": "_declaration"
      }
    },
    "_declaration": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "grammar_rule"
        }
      ]
    },
    "grammar_rule": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "_nonterminal_m_alias"
        },
        {
          "type": "STRING",
          "value": "::="
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SYMBOL",
            "name": "_production"
          }
        },
        {
          "type": "STRING",
          "value": "."
        }
      ]
    },
    "_nonterminal_m_alias": {
      "type": "SEQ",
      "members": [
        {
          "type": "FIELD",
          "name": "rule_name",
          "content": {
            "type": "SYMBOL",
            "name": "nonterminal"
          }
        },
        {
          "type": "FIELD",
          "name": "alias",
          "content": {
            "type": "CHOICE",
            "members": [
              {
                "type": "SYMBOL",
                "name": "alias"
              },
              {
                "type": "BLANK"
              }
            ]
          }
        }
      ]
    },
    "_production": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "_nonterminal_m_alias"
        },
        {
          "type": "SYMBOL",
          "name": "_terminal_m_alias"
        },
        {
          "type": "SYMBOL",
          "name": "_multiterminal_m_alias"
        }
      ]
    },
    "_terminal_m_alias": {
      "type": "PREC",
      "value": 2,
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "FIELD",
            "name": "rule_name",
            "content": {
              "type": "SYMBOL",
              "name": "terminal"
            }
          },
          {
            "type": "FIELD",
            "name": "alias",
            "content": {
              "type": "CHOICE",
              "members": [
                {
                  "type": "SYMBOL",
                  "name": "alias"
                },
                {
                  "type": "BLANK"
                }
              ]
            }
          }
        ]
      }
    },
    "_multiterminal_m_alias": {
      "type": "SEQ",
      "members": [
        {
          "type": "FIELD",
          "name": "rule_name",
          "content": {
            "type": "SYMBOL",
            "name": "multiterminal"
          }
        },
        {
          "type": "FIELD",
          "name": "alias",
          "content": {
            "type": "CHOICE",
            "members": [
              {
                "type": "SYMBOL",
                "name": "alias"
              },
              {
                "type": "BLANK"
              }
            ]
          }
        }
      ]
    },
    "nonterminal": {
      "type": "PATTERN",
      "value": "[a-z][a-zA-Z0-9_]*"
    },
    "terminal": {
      "type": "PATTERN",
      "value": "[A-Z][a-zA-Z0-9_]*"
    },
    "multiterminal": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "terminal"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SEQ",
            "members": [
              {
                "type": "CHOICE",
                "members": [
                  {
                    "type": "STRING",
                    "value": "|"
                  },
                  {
                    "type": "STRING",
                    "value": "/"
                  }
                ]
              },
              {
                "type": "SYMBOL",
                "name": "terminal"
              }
            ]
          }
        }
      ]
    },
    "alias": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "("
        },
        {
          "type": "PATTERN",
          "value": "[A-Za-z][A-Za-z0-9_]*"
        },
        {
          "type": "STRING",
          "value": ")"
        }
      ]
    }
  },
  "extras": [
    {
      "type": "PATTERN",
      "value": "\\s"
    }
  ],
  "conflicts": [],
  "precedences": [],
  "externals": [],
  "inline": [],
  "supertypes": [],
  "reserved": {}
}