{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/grammar.schema.json",
  "name": "zitron",
  "rules": {
    "source_file": {
      "type": "REPEAT",
      "content": {
        "type": "SYMBOL",
        "name": "_declaration"
      }
    },
    "_declaration": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "grammar_rule"
        },
        {
          "type": "SYMBOL",
          "name": "ditto_rule"
        }
      ]
    },
    "grammar_rule": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "_nonterminal_m_alias"
        },
        {
          "type": "STRING",
          "value": "::="
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "REPEAT",
              "content": {
                "type": "SYMBOL",
                "name": "_production"
              }
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "STRING",
          "value": "."
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "_action"
            },
            {
              "type": "BLANK"
            }
          ]
        }
      ]
    },
    "ditto_rule": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "``"
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "STRING",
              "value": "::="
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "REPEAT",
              "content": {
                "type": "SYMBOL",
                "name": "_production"
              }
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "STRING",
          "value": "."
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "_action"
            },
            {
              "type": "BLANK"
            }
          ]
        }
      ]
    },
    "_nonterminal_m_alias": {
      "type": "SEQ",
      "members": [
        {
          "type": "FIELD",
          "name": "rule_name",
          "content": {
            "type": "SYMBOL",
            "name": "nonterminal"
          }
        },
        {
          "type": "FIELD",
          "name": "alias",
          "content": {
            "type": "CHOICE",
            "members": [
              {
                "type": "SYMBOL",
                "name": "_alias_paren"
              },
              {
                "type": "BLANK"
              }
            ]
          }
        }
      ]
    },
    "_production": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "_nonterminal_m_alias"
        },
        {
          "type": "SYMBOL",
          "name": "_terminal_m_alias"
        },
        {
          "type": "SYMBOL",
          "name": "_multiterminal_m_alias"
        }
      ]
    },
    "_terminal_m_alias": {
      "type": "PREC",
      "value": 2,
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "FIELD",
            "name": "rule_name",
            "content": {
              "type": "SYMBOL",
              "name": "terminal"
            }
          },
          {
            "type": "FIELD",
            "name": "alias",
            "content": {
              "type": "CHOICE",
              "members": [
                {
                  "type": "SYMBOL",
                  "name": "_alias_paren"
                },
                {
                  "type": "BLANK"
                }
              ]
            }
          }
        ]
      }
    },
    "_multiterminal_m_alias": {
      "type": "SEQ",
      "members": [
        {
          "type": "FIELD",
          "name": "rule_name",
          "content": {
            "type": "SYMBOL",
            "name": "multiterminal"
          }
        },
        {
          "type": "FIELD",
          "name": "alias",
          "content": {
            "type": "CHOICE",
            "members": [
              {
                "type": "SYMBOL",
                "name": "_alias_paren"
              },
              {
                "type": "BLANK"
              }
            ]
          }
        }
      ]
    },
    "_alias_paren": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "("
        },
        {
          "type": "SYMBOL",
          "name": "rule_alias"
        },
        {
          "type": "STRING",
          "value": ")"
        }
      ]
    },
    "_action": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "code_block"
        },
        {
          "type": "SYMBOL",
          "name": "named_action"
        }
      ]
    },
    "code_block": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "{"
        },
        {
          "type": "PATTERN",
          "value": "[^}]*"
        },
        {
          "type": "STRING",
          "value": "}"
        }
      ]
    },
    "named_action": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "action_name"
        },
        {
          "type": "SYMBOL",
          "name": "_act_aliases"
        }
      ]
    },
    "_act_aliases": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "("
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SEQ",
              "members": [
                {
                  "type": "CHOICE",
                  "members": [
                    {
                      "type": "SYMBOL",
                      "name": "rule_alias"
                    },
                    {
                      "type": "BLANK"
                    }
                  ]
                },
                {
                  "type": "STRING",
                  "value": ";"
                },
                {
                  "type": "CHOICE",
                  "members": [
                    {
                      "type": "SYMBOL",
                      "name": "rule_alias"
                    },
                    {
                      "type": "BLANK"
                    }
                  ]
                },
                {
                  "type": "CHOICE",
                  "members": [
                    {
                      "type": "REPEAT",
                      "content": {
                        "type": "SEQ",
                        "members": [
                          {
                            "type": "STRING",
                            "value": ","
                          },
                          {
                            "type": "SYMBOL",
                            "name": "rule_alias"
                          }
                        ]
                      }
                    },
                    {
                      "type": "BLANK"
                    }
                  ]
                },
                {
                  "type": "CHOICE",
                  "members": [
                    {
                      "type": "STRING",
                      "value": ","
                    },
                    {
                      "type": "BLANK"
                    }
                  ]
                }
              ]
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "STRING",
          "value": ")"
        }
      ]
    },
    "nonterminal": {
      "type": "PATTERN",
      "value": "[a-z][a-zA-Z0-9_]*"
    },
    "terminal": {
      "type": "PATTERN",
      "value": "[A-Z][a-zA-Z0-9_]*"
    },
    "multiterminal": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "terminal"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SEQ",
            "members": [
              {
                "type": "CHOICE",
                "members": [
                  {
                    "type": "STRING",
                    "value": "|"
                  },
                  {
                    "type": "STRING",
                    "value": "/"
                  }
                ]
              },
              {
                "type": "SYMBOL",
                "name": "terminal"
              }
            ]
          }
        }
      ]
    },
    "rule_alias": {
      "type": "PATTERN",
      "value": "[A-Za-z][A-Za-z0-9_]*"
    },
    "action_name": {
      "type": "PATTERN",
      "value": "@[a-z][a-zA-Z0-9_]*"
    },
    "comment": {
      "type": "TOKEN",
      "content": {
        "type": "CHOICE",
        "members": [
          {
            "type": "SEQ",
            "members": [
              {
                "type": "STRING",
                "value": "//"
              },
              {
                "type": "PATTERN",
                "value": "(\\\\+(.|\\r?\\n)|[^\\\\\\n])*"
              }
            ]
          },
          {
            "type": "SEQ",
            "members": [
              {
                "type": "STRING",
                "value": "/*"
              },
              {
                "type": "PATTERN",
                "value": "[^*]*\\*+([^/*][^*]*\\*+)*"
              },
              {
                "type": "STRING",
                "value": "/"
              }
            ]
          }
        ]
      }
    }
  },
  "extras": [
    {
      "type": "PATTERN",
      "value": "\\s|\\\\\\r?\\n"
    },
    {
      "type": "SYMBOL",
      "name": "comment"
    }
  ],
  "conflicts": [],
  "precedences": [],
  "externals": [],
  "inline": [],
  "supertypes": [],
  "reserved": {}
}